# MiniMoth API Configuration
# Get your API key from https://minimoth.dev
MINIMOTH_API_KEY=mm_test_your_sandbox_key
MINIMOTH_BASE_URL=https://api.minimoth.dev/v1

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# Sandbox / Fallback Mode:
# When enabled, if the MiniMoth API key is the default placeholder or invalid,
# the backend simulates WhatsApp/SMS delivery (accepting OTP 123456)
# so you can test the frontend UI immediately without a live API key.
ALLOW_MOCK_FALLBACK=true
